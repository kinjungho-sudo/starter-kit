---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  let items: any[] = [];
  try { items = await getCollection('wiki'); } catch { items = []; }
  return items.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const EMOJI: Record<string, string> = {
  'AI에이전트': '🤖', '창업': '🚀', '독서노트': '📚', '자동화': '⚙️',
  '개발': '💻', '콘텐츠': '✍️', '유튜브': '🎬', '나': '🪞',
  '성공': '🏆', '리서치': '🔍', '글쓰기': '📝', '기타': '📄',
};
---

<Layout title={d.title ?? entry.id}>

  <!-- 브레드크럼 -->
  <div style="display:flex; align-items:center; gap:6px; font-size:11px; color:rgba(255,255,255,0.3); margin-bottom:20px;">
    <a href="/wiki" style="color:rgba(255,255,255,0.3); text-decoration:none;">Wiki</a>
    <span>›</span>
    {d.category && <><a href="/wiki" style="color:rgba(255,255,255,0.3); text-decoration:none;">{EMOJI[d.category] ?? ''} {d.category}</a><span>›</span></>}
    <span style="color:rgba(255,255,255,0.6);">{d.title ?? entry.id}</span>
  </div>

  <!-- 헤더 -->
  <div style="margin-bottom:24px;">
    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
      {d.category && (
        <span style="font-size:9px; font-weight:800; letter-spacing:0.08em; text-transform:uppercase;
          padding:2px 8px; border-radius:4px; background:rgba(129,140,248,0.12); color:#818cf8;
          border:1px solid rgba(129,140,248,0.25);">
          {EMOJI[d.category] ?? ''} {d.category}
        </span>
      )}
      {d.type && (
        <span style="font-size:9px; font-weight:600; color:rgba(255,255,255,0.3); letter-spacing:0.05em;">{d.type}</span>
      )}
      {d.created && (
        <span style="font-size:11px; color:rgba(255,255,255,0.3);">{String(d.created).slice(0, 10)}</span>
      )}
    </div>
    <h1 style="font-size:22px; font-weight:900; color:#fff; margin:0 0 8px; line-height:1.3;">{d.title ?? entry.id}</h1>

    {d.tags && d.tags.length > 0 && (
      <div style="display:flex; flex-wrap:wrap; gap:5px; margin-top:10px;">
        {d.tags.map((t: string) => (
          <span style="font-size:10px; padding:2px 8px; border-radius:4px;
            background:rgba(255,255,255,0.05); color:rgba(255,255,255,0.4);
            border:1px solid rgba(255,255,255,0.08);">#{t}</span>
        ))}
      </div>
    )}

    {d.source && d.source !== '' && (
      <div style="margin-top:10px;">
        <a href={d.source} target="_blank" rel="noopener"
          style="font-size:11px; color:#818cf8; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
          ↗ 원본 출처
        </a>
      </div>
    )}
  </div>

  <!-- 본문 -->
  <article class="wiki-prose">
    <Content />
  </article>

  <!-- 뒤로 -->
  <div style="margin-top:40px; padding-top:16px; border-top:1px solid rgba(255,255,255,0.06);">
    <a href="/wiki" style="font-size:12px; color:rgba(255,255,255,0.3); text-decoration:none;">← Wiki 목록으로</a>
  </div>

</Layout>

<style>
  .wiki-prose {
    color: rgba(255,255,255,0.75);
    line-height: 1.85;
    font-size: 14px;
  }
  .wiki-prose :global(h1) { font-size: 1.25rem; font-weight: 900; color: #fff; margin: 2rem 0 0.6rem; }
  .wiki-prose :global(h2) { font-size: 1.05rem; font-weight: 800; color: #fff; margin: 1.6rem 0 0.5rem; }
  .wiki-prose :global(h3) { font-size: 0.95rem; font-weight: 700; color: rgba(255,255,255,0.85); margin: 1.2rem 0 0.4rem; }
  .wiki-prose :global(p) { margin-bottom: 0.9rem; }
  .wiki-prose :global(ul), .wiki-prose :global(ol) { padding-left: 1.5rem; margin-bottom: 0.9rem; }
  .wiki-prose :global(li) { margin-bottom: 0.3rem; }
  .wiki-prose :global(a) { color: #818cf8; }
  .wiki-prose :global(strong) { color: #fff; font-weight: 700; }
  .wiki-prose :global(blockquote) {
    border-left: 3px solid rgba(129,140,248,0.5);
    padding: 4px 12px;
    margin: 12px 0;
    color: rgba(255,255,255,0.5);
    font-style: italic;
  }
  .wiki-prose :global(code) {
    font-size: 12px; padding: 2px 6px; border-radius: 4px;
    background: rgba(255,255,255,0.08); color: #a5b4fc;
    font-family: 'JetBrains Mono', monospace;
  }
  .wiki-prose :global(pre) {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 14px 16px;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .wiki-prose :global(pre code) {
    background: none; padding: 0; color: rgba(255,255,255,0.7);
  }
  .wiki-prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.08);
    margin: 1.5rem 0;
  }
  .wiki-prose :global(table) { width: 100%; border-collapse: collapse; margin-bottom: 1rem; font-size: 13px; }
  .wiki-prose :global(th) {
    text-align: left; padding: 8px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5); font-size: 11px; font-weight: 700; text-transform: uppercase;
  }
  .wiki-prose :global(td) {
    padding: 7px 12px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.65);
  }
</style>
